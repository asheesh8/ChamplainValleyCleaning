# Local dev uses SQLite. For deployment switch `provider` in
# prisma/schema.prisma to "postgresql" and put the Postgres URL here.
DATABASE_URL="file:./prisma/dev.db"

# Change this before anything is deployed.
SESSION_SECRET="generate-a-long-random-string"

# Only read by prisma/seed.ts, on first seed.
ADMIN_EMAIL="owner@champlainvalleycleaning.com"
ADMIN_PASSWORD="change-me"
